{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gift-wish",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // The web app (public/) is served as static files. Only /api/* runs the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // The live D1 database. Schema changes live in migrations/; `npm run deploy`
  // applies any new ones before deploying the code.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gift-wish",
      "database_id": "478af312-12a7-4ddc-b875-f7be28fc1df9",
      "migrations_dir": "migrations"
    }
  ]
}
